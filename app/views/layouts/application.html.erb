<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("site.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= yield :head %>
  </head>
  <body>
    <a class="visually-hidden-focusable position-absolute p-3 bg-white" href="#content"><%= t("layouts.application.skip_to_content") %></a>
    <header class="border-bottom">
      <div class="container py-3 d-flex justify-content-between align-items-center">
        <%= link_to t("site.name"), root_path, class: "fs-4 fw-semibold text-decoration-none" %>
        <nav aria-label="<%= t("layouts.application.language") %>">
          <% I18n.available_locales.each do |locale| %>
            <%= link_to t("locales.#{locale}"), root_path(locale: (locale unless locale == I18n.default_locale)),
                        lang: locale, hreflang: locale, class: "ms-3", "aria-current": ("page" if locale == I18n.locale) %>
          <% end %>
        </nav>
      </div>
    </header>
    <main id="content" class="container py-5" tabindex="-1">
      <%= yield %>
    </main>
  </body>
</html>
